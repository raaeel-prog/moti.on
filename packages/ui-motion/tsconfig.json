  "$comment": "Catálogo e preferência puros, compatíveis com o menor denominador entre CEP e UXP.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": [],

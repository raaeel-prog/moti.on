{
  "id": "com.example.crosshosttoolkit.premiere",
  "name": "CrossHost Toolkit",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": {
        "default": "CrossHost Toolkit"
      },
      "minimumSize": {
        "width": 260,
        "height": 280
      },
      "maximumSize": {
        "width": 1600,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 520
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 560
      }
    }
  ]
}

<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest
  Version="7.0"
  ExtensionBundleId="com.motion.plugin"
  ExtensionBundleVersion="0.2.0"
  ExtensionBundleName="Moti.on"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.motion.plugin.ae.panel" Version="0.2.0" />
    <Extension Id="com.motion.plugin.ae.quick-ease" Version="0.2.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[25.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="12.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.motion.plugin.ae.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Moti.on</Menu>
          <Geometry>
            <Size>
              <Height>520</Height>
              <Width>340</Width>
            </Size>
            <MinSize>
              <Height>280</Height>
              <Width>280</Width>
            </MinSize>
            <MaxSize>
              <Height>1600</Height>
              <Width>1600</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <!-- Janela flutuante "Suavizacao rapida": mesma curva e mesmo comando do painel,
         numa janela Modeless (CEP 12 Cookbook) aberta pelo painel via
         requestOpenExtension ou pelo menu de extensoes. O painel acima precisa
         continuar PRIMEIRO: validate.mjs le o primeiro MinSize. -->
    <Extension Id="com.motion.plugin.ae.quick-ease">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/quick-ease.html</MainPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Modeless</Type>
          <Menu>Moti.on - Suavizacao rapida</Menu>
          <Geometry>
            <Size>
              <Height>360</Height>
              <Width>300</Width>
            </Size>
            <MinSize>
              <Height>320</Height>
              <Width>280</Width>
            </MinSize>
            <MaxSize>
              <Height>900</Height>
              <Width>700</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>

# Normalizacao de fim de linha.
#
# O CI roda em ubuntu-latest e em windows-latest, e o gate do CHMS-002 compara
# SHA-256 de dist/ entre as duas plataformas. Sem normalizacao explicita, cada
# checkout produziria bytes diferentes e a paridade falharia por um motivo que
# nao tem nada a ver com a migracao.

* text=auto eol=lf

# Scripts que so rodam em cada plataforma mantem o fim de linha nativo.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.sh   text eol=lf

# ExtendScript e lido pelo After Effects; LF e seguro e mantem o hash estavel.
*.jsx  text eol=lf

# Binarios nunca sao normalizados.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zxp  binary
*.ccx  binary
*.zip  binary
*.woff binary
*.woff2 binary
*.bin  binary

# Arquivos gerados nao poluem o diff nem contam como codigo autoral.
tests/fixtures/*.json           linguist-generated=true
shared/crosshost.tokens.css     linguist-generated=true
shared/crosshost.tokens.json    linguist-generated=true

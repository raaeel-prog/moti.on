# Normalizacao de fim de linha.
#
# O CI roda em ubuntu-latest e em windows-latest, e o gate do CHMS-002 compara
# SHA-256 de dist/ entre as duas plataformas. Sem normalizacao explicita, cada
# checkout produziria bytes diferentes e a paridade falharia por um motivo que
# nao tem nada a ver com a migracao.

* text=auto eol=lf

# Scripts que so rodam em cada plataforma mantem o fim de linha nativo.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.sh   text eol=lf

# ExtendScript e lido pelo After Effects; LF e seguro e mantem o hash estavel.
*.jsx  text eol=lf

# Binarios nunca sao normalizados.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zxp  binary
*.ccx  binary
*.zip  binary
*.woff binary
*.woff2 binary
*.bin  binary

# Arquivos gerados nao poluem o diff nem contam como codigo autoral.
tests/fixtures/*.json           linguist-generated=true
shared/crosshost.tokens.css     linguist-generated=true
shared/crosshost.tokens.json    linguist-generated=true

# Midia de previa e de evidencia: binario, sem normalizacao e sem diff textual.
# Ficam no Git normal (o conjunto atual tem ~40 MB); nenhum arquivo deve passar
# de 50 MB. Ver CONTRIBUTING.md > Midia e Git LFS.
*.mp4  binary
*.webm binary
*.m4v  binary
*.jpeg binary
*.webp binary
*.mp3  binary
*.m4a  binary
*.ogg  binary
*.ffx  binary
*.aex  binary
*.dll  binary
*.exe  binary
*.ttf  binary
*.otf  binary

# Git LFS somente para formatos pesados NOVOS. Nenhum arquivo com estas
# extensoes existe no historico, entao nada e migrado nem reescrito.
*.mov  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.aif  filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.aep  filter=lfs diff=lfs merge=lfs -text
*.mxf  filter=lfs diff=lfs merge=lfs -text
